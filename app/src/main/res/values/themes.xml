<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.R005_Student_Assignment_Tracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_indigo</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.R005_Student_Assignment_Tracker" parent="Base.Theme.R005_Student_Assignment_Tracker" />

    <style name="CalendarViewTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="colorPrimary">@color/primary_indigo</item>
    </style>

    <style name="CalendarDateText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarWeekDayText">
        <item name="android:textColor">@color/primary_indigo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
